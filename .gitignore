# ===========================================================================
#  Karst - what does NOT belong in the repository
# ===========================================================================
#  Measured before this file was written: the working tree was ~705 MB, of
#  which 570 MB was .vs\ and ~135 MB was build output. A clean checkout is
#  about 7 MB. Everything excluded here is either regenerated by a build or
#  produced by a tool run.
#
#  Deliberately NOT ignored (they are generated but shipped on purpose, because
#  the whole point of those pages is that a user double-clicks them):
#     tools\script-editor\script-editor.html
#     tools\script-studio\KarstScriptStudio.html
#     script-editor.html                (a copy kept at the repo root)
#  If you edit tools\script-*\*.template.html or blocks\*.js, re-run the
#  matching build script and commit the regenerated HTML in the same change.
# ===========================================================================

# --- C++ build output ------------------------------------------------------
Debug/
Release/
*.obj
*.lib
*.exp
*.pdb
*.ilk
*.idb
*.iobj
*.ipdb
*.pgd
*.aps
*.tlog
*.lastbuildstate
*.log
*.user

# The built tools (tools\*.exe) are products of tools\build_tools.bat.
# Scoped to tools\ on purpose: a bare *.dll/*.exe rule would also swallow
# refs\karstpatcher\Libraries\*.dll, which are NOT NuGet-restorable and must
# be committed (they come from the VS SDK).
tools/*.exe
tools/*.obj

# Karst.dll is the build product; it is distributed through dist\, never from
# the source tree. (Placed here rather than relying on Release/ alone, because
# a stray copy at the root has happened.)
/Karst.dll
/karst.log
/karst.log.*

# --- C# reference layers ---------------------------------------------------
# build_refs.bat regenerates these. NuGet restores Roslyn/Newtonsoft on the
# first run (needs internet once).
refs/**/bin/
refs/**/obj/
!refs/karstpatcher/Libraries/*.dll

# --- packaging -------------------------------------------------------------
dist/
# package_full.ps1 writes here: a folder in the repo root with a
# self-explanatory (Chinese) name. "dist/" is kept for checkouts that still use
# the old name. Neither belongs in git - the zip is a build product.
发布包/

# --- generated by tools ----------------------------------------------------
tools/__pycache__/
__pycache__/
*.pyc

# script-studio: 92 compile fixtures are regenerated by
# "node tests\run_tests.js --compile", and gamedata.json is re-extracted from
# the game's rules files by build_studio.ps1. Neither is source.
tools/script-studio/tests/cases/
tools/script-studio/data/

# --- editor / OS litter ----------------------------------------------------
.vs/
.vscode/
*.VC.db
*.VC.VC.opendb
*.suo
*.bak
*.orig
*.rej
Thumbs.db
desktop.ini

# --- local scratch ---------------------------------------------------------
# Throwaway analysis helpers (one-off probe / rename scripts). Never shipped,
# never referenced by the build.
_scratch/
